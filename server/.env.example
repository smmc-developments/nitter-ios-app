# Docker Compose release image and host port.
NITTER_VERSION=latest
HOST_PORT=3000

# Use long random values. Configure API_KEY in the iOS app as well.
API_KEY=replace-with-a-random-secret

# Keep this stable so signed media URLs remain valid across container replacements.
PROXY_SECRET=replace-with-a-different-random-secret

# Optional browser login for the web app. Set both values or leave both empty.
WEB_USERNAME=reader
WEB_PASSWORD=replace-with-a-strong-password

# Set to true only for an isolated local test environment.
ALLOW_INSECURE_NO_AUTH=false

TWV_API_URL=https://api.twitterwebviewer.com
TWV_SITE_URL=https://twitterwebviewer.com

FETCH_MINUTES=15

# debug, info, warn, error, or silent. Database/parser tracing requires debug.
LOG_LEVEL=info

# Automatic cycles fetch at most this many due accounts. Manual fetches still fetch all.
MAX_ACCOUNTS_PER_CYCLE=40

# Conservative defaults: two in-flight requests, starts spaced one second apart.
FETCH_CONCURRENCY=2
FETCH_START_INTERVAL_MS=1000

# Follow timeline cursors to catch bursts and gradually backfill older posts.
MAX_PAGES_PER_ACCOUNT=5
